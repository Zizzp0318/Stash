{
  "name": "stash",
  "version": "0.1.2",
  "description": "Stash · 素材库 - Windows 本地素材管理软件",
  "author": "Zizzp0318",
  "private": true,
  "main": "out/main/main.js",
  "scripts": {
    "dev": "electron-vite dev",
    "predev": "node scripts/clean-vite-tmp.mjs",
    "build": "electron-vite build",
    "postbuild": "node scripts/clean-vite-tmp.mjs",
    "start": "electron-vite preview",
    "icon": "node scripts/make-icon.mjs",
    "clean:build": "node scripts/clean-build.mjs",
    "package:win": "npm run clean:build -- --with-packages && npm run build && npm run package:win:setup && npm run package:win:portable",
    "package:win:setup": "electron-builder --win --x64 --publish never --config electron-builder.yml",
    "package:win:portable": "node scripts/make-portable.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@panzoom/panzoom": "^4.6.2",
    "chokidar": "^5.0.0",
    "ffmpeg-static": "^5.3.0",
    "markdown-it": "^15.0.2",
    "pinia": "^4.0.3",
    "sharp": "^0.35.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "@rollup/rollup-win32-x64-msvc": "^4.63.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
